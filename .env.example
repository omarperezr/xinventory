# Copy to .env.local and fill in your Supabase project values.
# Both are exposed to the browser (Vite VITE_ prefix). The anon/publishable
# key is safe to ship — access is protected by Row Level Security — but keep
# the real values out of source control.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# ── Paid modules (per-instance) ──────────────────────────────────────────
# "true" ships the module; anything else (including unset) excludes it from
# the BUILD — the code never reaches the bundle, it is not merely hidden.
# Docker: pass as --build-arg (see Dockerfile). Vercel: set in the dashboard.
# Data side per instance: do not run a module's migrations for clients who
# did not buy it; RLS covers the rest.
VITE_MODULE_FINANZAS=true
VITE_MODULE_REPORTES=true
VITE_MODULE_REDES=true

# Server-side only (set in the Vercel dashboard, never VITE_-prefixed).
# Used by api/social-generate.ts — the Redes Sociales batch generator.
# SUPABASE_SERVICE_ROLE_KEY: Supabase project settings > API > service_role.
# CRON_SECRET: any long random string; Vercel Cron sends it automatically as
#   "Authorization: Bearer <CRON_SECRET>" once the env var exists.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=your-long-random-string

# Server half of the Redes module switch: api/social-generate.ts returns 404
# unless this is exactly "true". Set only for instances that bought Redes.
MODULE_REDES=true

# ── Provisioning (scripts/new-client.sh, dev machine only) ───────────────
# Tokens the script uses to create client instances. Never deployed anywhere.
# Supabase: dashboard > Account Settings > Access Tokens.
# Vercel: vercel.com > Account Settings > Tokens.
# SUPABASE_NEW_CLIENT=sbp_your-token
# VERCEL_NEW_CLIENT=your-vercel-token
