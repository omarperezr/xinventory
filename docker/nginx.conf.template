# Rendered by the nginx image's envsubst entrypoint: ${API_ORIGIN} comes from
# the container environment; nginx's own $vars are left untouched.
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  # Serverless functions (usdt-rate, social-generate, storage-cleanup) do not
  # run in this container; forward them to the deployment that hosts them.
  location /api/ {
    proxy_pass ${API_ORIGIN};
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
  }

  # SPA fallback — same rewrite vercel.json does in production.
  location / {
    try_files $uri /index.html;
  }

  # The shell must be revalidated on every load. With nginx's defaults it only
  # carries Last-Modified, and heuristic freshness (10% of the file's age) lets
  # a browser — and the service worker's network-first navigation, which honors
  # the HTTP cache — pin a returning user to the previous build for days: stale
  # HTML asks for the old hashed chunks and the old sw.js, so the update never
  # fires. Everything under /assets/ keeps its cache; those names change per
  # build. Both `/` (via the index directive) and the fallback above land here
  # as internal redirects, so they get the header too.
  location = /index.html {
    add_header Cache-Control "no-cache";
  }
}
